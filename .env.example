# Copy to .env and adjust. Never commit .env.

# Backend
ARTIFACTS_DIR=artifacts
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Frontend (optional; defaults to /api/v1 through the Vite proxy)
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY=http://localhost:8000

# Only for optional LLM experiments on PUBLIC benchmark data. Never use with PartLogic data.
# LLM_API_KEY=
